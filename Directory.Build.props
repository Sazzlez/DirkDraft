<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!--
      InvariantGlobalization is deliberately NOT set. It saves a few megabytes, but WPF needs real
      culture data for data binding (XmlLanguage.GetSpecificCulture throws without it) and the app
      crashes on the first bound control. It would also pin number formatting to English, which is
      wrong for a German user reading percentages.
    -->
  </PropertyGroup>
</Project>

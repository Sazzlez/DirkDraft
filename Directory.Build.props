<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!--
      InvariantGlobalization is deliberately NOT set: the tools write reports for a German reader
      (de-DE percentages and thousands separators), and invariant mode would pin them to English.
    -->
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraftPilot.Core\DraftPilot.Core.csproj" />
    <ProjectReference Include="..\DraftPilot.Meta\DraftPilot.Meta.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Curated, read-only data files ship next to the executable. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\data\*.json"
             Link="data\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

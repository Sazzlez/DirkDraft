<Window x:Class="DraftPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DraftPilot.App.ViewModels"
        Title="DirkDraft"
        Width="1120" Height="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Icon tile. Sits behind the portrait and stands in for it while a seat is still hidden. -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChampion}" Value="False">
                    <Setter Property="Background" Value="#171A20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Champion name: dimmed until the pick is locked, so a hover reads as provisional. -->
        <Style x:Key="ChampionName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            One item/rune/spell tile: the icon with the name on hover, falling back to a text chip
            while the icon has not been downloaded yet. The build view must work from the first
            second — text first, pictures when they land.
        -->
        <DataTemplate x:Key="IconChip" DataType="{x:Type vm:IconChipViewModel}">
            <Border Margin="0,0,6,4" CornerRadius="7" ClipToBounds="True"
                    Background="{StaticResource SurfaceAlt}"
                    ToolTip="{Binding Hint}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="{Binding Label}" FontSize="11" Margin="8,2"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               MaxWidth="150" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A horizontal row of icon chips. -->
        <ItemsPanelTemplate x:Key="ChipRow">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- The same tile at 26 px, for the narrow build column during the draft. -->
        <DataTemplate x:Key="IconChipSmall" DataType="{x:Type vm:IconChipViewModel}">
            <Border Margin="0,0,5,3" CornerRadius="6" ClipToBounds="True"
                    Background="{StaticResource SurfaceAlt}"
                    ToolTip="{Binding Hint}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="{Binding Label}" FontSize="10" Margin="6,2"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               MaxWidth="84" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        <!--
            The build body, defined once and placed twice: in the narrow left card during a
            draft, and in the wide middle column once the own pick is locked and nobody on
            our team is on the clock. The chip rows wrap, so the same markup uses whatever
            width it is given instead of needing a second, wider copy.
        -->
        <DataTemplate x:Key="BuildBody">
            <StackPanel>
                        <!-- Hint while nothing is loaded yet (draft only). -->
                        <TextBlock Text="{Binding BuildHint}"
                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,7,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBuild}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
    
                        <StackPanel Visibility="{Binding HasBuild, Converter={StaticResource BoolToVisibility}}">
                            <!-- Runes as tiles, keystone ringed; shards as text (their icons say nothing). -->
                            <ItemsControl ItemsSource="{Binding GameBuild.PrimaryRunes}"
                                          ItemTemplate="{StaticResource IconChipSmall}"
                                          ItemsPanel="{StaticResource ChipRow}" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding GameBuild.SecondaryRunes}"
                                          ItemTemplate="{StaticResource IconChipSmall}"
                                          ItemsPanel="{StaticResource ChipRow}" />
                            <TextBlock Text="{Binding GameBuild.ShardText}" Style="{StaticResource Small}"
                                       FontSize="10" Margin="0,1,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Faint}"
                                       ToolTip="Stat-Shards: die drei kleinen Zusatzwerte unter den Runen." />
    
                            <!--
                                The tool's ONE write to the client: creates/replaces the page
                                "DirkRunen · …" and selects it. Deletes only its own page; a foreign
                                page falls only after a yes in a dialog that names it.
                            -->
                            <DockPanel LastChildFill="False" Margin="0,5,0,0">
                                <Button Style="{StaticResource Ghost}" Content="Runen übertragen"
                                        Command="{Binding ImportRunesCommand}"
                                        ToolTip="Legt diese Runenseite im League-Client an und wählt sie aus. Ersetzt nur die eigene DirkRunen-Seite; eine fremde Seite wird nie ohne Nachfrage gelöscht. Funktioniert bis zum Ladebildschirm." />
                                <TextBlock Text="{Binding RuneImportText}" Style="{StaticResource Small}"
                                           FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
    
                            <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,8,0,7" />
    
                            <!--
                                Purchase order, same tiles as the in-game view — and the same Grid
                                reasoning: the star column bounds the wrap panel, the Auto columns
                                keep trailing labels and chips from being squeezed to zero when the
                                text fallback fills the narrow column.
                            -->
                            <!--
                                Spells live in the FIRST row on purpose: start items and boots are
                                always plain icons, so there is guaranteed room. Hanging them off the
                                "Spät" row put them at the card's bottom edge, where late items in
                                their text fallback (Ornn upgrades never get icons) wrapped the row
                                and pushed the spells half out of the window.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start" Style="{StaticResource Small}" FontSize="10"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,6,7,3" MinWidth="34" />
                                <!--
                                    One flowing wrap row: each group keeps its natural size and drops
                                    to the next line when the column is tight. Fixed trailing columns
                                    starved whichever group came first once text-fallback chips
                                    widened the others.
                                -->
                                <WrapPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding GameBuild.StartItems}"
                                                  ItemTemplate="{StaticResource IconChipSmall}"
                                                  ItemsPanel="{StaticResource ChipRow}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Schuhe" Style="{StaticResource Small}" FontSize="10"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                                   Margin="10,6,7,3" />
                                        <ItemsControl ItemsSource="{Binding GameBuild.BootItems}"
                                                      ItemTemplate="{StaticResource IconChipSmall}"
                                                      ItemsPanel="{StaticResource ChipRow}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Spells" Style="{StaticResource Small}" FontSize="10"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                                   Margin="10,6,7,3" />
                                        <ItemsControl ItemsSource="{Binding GameBuild.Spells}"
                                                      ItemTemplate="{StaticResource IconChipSmall}"
                                                      ItemsPanel="{StaticResource ChipRow}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kern" Style="{StaticResource Small}" FontSize="10"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,6,7,3" MinWidth="34"
                                           ToolTip="In dieser Reihenfolge kaufen — die meistgespielte Kombination dieses Matchups." />
                                <!-- Stats ride along inside the wrap row so they stay next to the items
                                     instead of drifting to the far edge on a wide card. -->
                                <WrapPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding GameBuild.CoreItems}"
                                                  ItemTemplate="{StaticResource IconChipSmall}"
                                                  ItemsPanel="{StaticResource ChipRow}" />
                                    <TextBlock Text="{Binding GameBuild.CoreStats}" Style="{StaticResource Small}"
                                               FontSize="10" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Top" Margin="6,6,0,3" />
                                </WrapPanel>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spät" Style="{StaticResource Small}" FontSize="10"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,6,7,3" MinWidth="34"
                                           ToolTip="Häufige Käufe für die letzten Slots — Optionen, keine feste Reihenfolge." />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GameBuild.LateItems}"
                                              ItemTemplate="{StaticResource IconChipSmall}"
                                              ItemsPanel="{StaticResource ChipRow}" />
                            </Grid>
    
                            <TextBlock Text="{Binding GameBuild.SkillText}" Style="{StaticResource Small}"
                                       FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource Muted}"
                                       ToolTip="Reihenfolge, in der die Fähigkeiten gemaxt werden. Die Tabelle für jede einzelne Stufe zeigt das Fenster nach Spielstart." />
    
                            <!-- Situational pointers from the enemy composition. -->
                            <ItemsControl ItemsSource="{Binding BuildHints}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="9"
                                                Padding="8,2" Margin="0,0,5,4"
                                                ToolTip="{Binding Hint}">
                                            <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="10">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <!-- Title bar · turn card (or idle checklist) · three-column content · footer. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== Title bar ===================== -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" Height="32"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The mark from the app icon, vector-drawn so it stays crisp at this size. -->
                    <Image Source="{StaticResource AppMarkSmall}" Width="20" Height="20"
                           Margin="0,0,9,0" VerticalAlignment="Center" />

                    <TextBlock Text="DirkDraft" Style="{StaticResource Title}" VerticalAlignment="Center" />

                    <!-- Connection state as a coloured dot; the text beside it stays secondary. -->
                    <Ellipse Width="8" Height="8" Margin="12,1,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Faint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Ok">
                                        <Setter Property="Fill" Value="{StaticResource Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}"
                               Foreground="{StaticResource Faint}" Margin="0,3,0,0" VerticalAlignment="Center" />

                    <!-- Update pill: the start-up check found a newer release. Reachable from every
                         screen, never more than one line, and nothing happens without the click. -->
                    <Button Style="{StaticResource Ghost}" Margin="14,0,0,0" Padding="9,1" Height="22"
                            FontSize="11" Command="{Binding InstallUpdateCommand}"
                            Content="{Binding UpdateNotice}"
                            ToolTip="Lädt die neue Version von GitHub und startet das Tool neu. Ohne diesen Klick passiert nichts."
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- A hairline of the brand gradient, sitting in the title bar's empty bottom edge.
                     Deliberately faint: an accent, not a banner. -->
                <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                        Background="{StaticResource BrandLine}" CornerRadius="1" Margin="0,0,0,1" />

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                        Click="Hide_Click" ToolTip="In den Infobereich minimieren">
                    <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{StaticResource Muted}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- ===================== Turn card (only while a draft runs) ===================== -->
            <Border Grid.Row="1" Background="{StaticResource Surface}"
                    BorderThickness="1" CornerRadius="10" Padding="13,9" Margin="0,3,0,0"
                    Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
                        <Style.Triggers>
                            <!--
                                Your own turn is the one moment the panel must not be overlooked. The
                                brand gradient runs around the frame and turns while the turn lasts:
                                motion in a static panel draws the eye without adding a single pixel
                                of size. Stopped on exit, so nothing animates while nobody is on the
                                clock. One full turn per thirty seconds - about one pick timer - at
                                20 fps: barely perceptible motion, and cheap under software rendering.
                            -->
                            <DataTrigger Binding="{Binding IsMyTurn}" Value="True">
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <LinearGradientBrush.RelativeTransform>
                                                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0" />
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#3B82F6" Offset="0" />
                                            <GradientStop Color="#22C55E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinBrand">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.RelativeTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:30"
                                                             RepeatBehavior="Forever"
                                                             Timeline.DesiredFrameRate="20" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinBrand" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!--
                    The status IS the headline. There used to be a countdown here plus a phase
                    bar; both are gone on purpose. The client only reports the remaining seconds
                    when it pushes an update, so any clock built on them drifts against the one
                    in the client — and two clocks disagreeing by a second or two is worse than
                    one. The client's timer is always on screen anyway; this card answers the
                    question the client answers badly: who is on the clock right now.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Big enough to read from the corner of the eye; accent-coloured on your
                         own turn, which together with the card's accent border is the one moment
                         this panel is allowed to shout. -->
                    <TextBlock Text="{Binding TurnText}" VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}" FontSize="23" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMyTurn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Where in the draft we are, as quiet context beside the headline rather
                         than a second line under it: it must not compete for the first glance. -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                            Background="{StaticResource SurfaceHi}" CornerRadius="10" Padding="10,4">
                        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Caption}"
                                   Margin="0" Foreground="{StaticResource Muted}" />
                    </Border>
                </Grid>
            </Border>

            <!--
                ===================== Idle hero =====================
                Between drafts the window used to be a small card in one corner and 90 % black. The
                hero centres the mark, the name and the two answers an idle window owes its user —
                is the client connected, are there data — in the space that is empty anyway. It
                yields to any build card (ShowIdleHero), because a kept-open shopping order beats a
                logo. RowSpan reaches into the content row, whose columns are all collapsed here.
            -->
            <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,0,0,34"
                        Visibility="{Binding ShowIdleHero, Converter={StaticResource BoolToVisibility}}">

                <Image Source="{StaticResource AppMark}" Width="88" Height="88" HorizontalAlignment="Center" />

                <TextBlock Text="DirkDraft" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />

                <TextBlock Text="Wartet auf das nächste Champ Select — das Fenster füllt sich dann von selbst."
                           Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,7,0,0" />

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,28,0,0"
                        MinWidth="460">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Faint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusTone}" Value="Ok">
                                                <Setter Property="Fill" Value="{StaticResource Good}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Style="{StaticResource Small}" VerticalAlignment="Center">
                                <Run Text="League-Client: " Foreground="{StaticResource Muted}" /><Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMeta}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Good}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding SnapshotText}"
                                       VerticalAlignment="Center" ToolTip="{Binding SnapshotDetail}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMeta}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- The third answer an idle window can owe: a newer version exists. -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"
                                     VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateNotice}"
                                       Style="{StaticResource Small}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Jetzt aktualisieren"
                                    Margin="12,0,0,0" Padding="10,2" FontSize="12"
                                    Command="{Binding InstallUpdateCommand}"
                                    ToolTip="Lädt die neue Version von GitHub und startet das Tool neu. Ohne diesen Klick passiert nichts." />
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,11,0,8" />

                        <TextBlock Text="{Binding BuildInfoText}" FontSize="10"
                                   Foreground="{StaticResource Faint}" Margin="18,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <!--
                ===================== In-game build view =====================
                Shown while the game runs: the drafted matchup's runes, purchase order with item
                pictures, and the level-by-level skill table. Same row as the idle card — the two
                are mutually exclusive by ShowIdleCard/ShowGameView.
            -->
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,3,0,0"
                    Visibility="{Binding ShowGameView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GameBuild.Title}" Style="{StaticResource Title}" />
                        <TextBlock Grid.Column="1" Text="{Binding GameBuild.Subtitle}"
                                   Style="{StaticResource Small}" Foreground="{StaticResource Faint}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding CloseBuildCommand}"
                                ToolTip="Build-Ansicht schließen">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <!-- Runes: keystone ringed, shards as text (their icons are generic arrows). -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RUNEN" Style="{StaticResource Caption}" VerticalAlignment="Top"
                                   Margin="0,10,14,0" />
                        <StackPanel Grid.Column="1">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding GameBuild.PrimaryPath}" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Faint}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,8,4" MinWidth="70" />
                                <ItemsControl ItemsSource="{Binding GameBuild.PrimaryRunes}"
                                              ItemTemplate="{StaticResource IconChip}"
                                              ItemsPanel="{StaticResource ChipRow}" />
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding GameBuild.SecondaryPath}" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Faint}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,8,4" MinWidth="70" />
                                <ItemsControl ItemsSource="{Binding GameBuild.SecondaryRunes}"
                                              ItemTemplate="{StaticResource IconChip}"
                                              ItemsPanel="{StaticResource ChipRow}" />
                                <TextBlock Text="{Binding GameBuild.ShardText}" Style="{StaticResource Small}"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,4"
                                           ToolTip="Stat-Shards: die drei kleinen Zusatzwerte unter den Runen." />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,8,0,10" />

                    <!-- Purchase order. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="KAUFEN" Style="{StaticResource Caption}" VerticalAlignment="Top"
                                   Margin="0,10,14,0"
                                   ToolTip="Reihenfolge: Start-Items → Schuhe → die drei Kern-Items → späte Optionen." />
                        <!--
                            Each purchase row is a Grid, not a StackPanel or DockPanel: only the
                            star column bounds the wrap panel (a StackPanel measured it with
                            infinity, so it never wrapped), and only Auto columns keep the
                            trailing label and chips alive (a DockPanel squeezed them to zero
                            width once the leading chips filled the line in the text fallback).
                        -->
                        <StackPanel Grid.Column="1">
                            <!-- Groups flow left to right inside one wrap row. Trailing Auto
                                 columns would pin "Schuhe" to the far right edge of a 1090-px
                                 card, a hand's width away from the items it belongs to. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start" Style="{StaticResource Small}" FontSize="11"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,7,8,4" MinWidth="70" />
                                <WrapPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding GameBuild.StartItems}"
                                                  ItemTemplate="{StaticResource IconChip}"
                                                  ItemsPanel="{StaticResource ChipRow}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Schuhe" Style="{StaticResource Small}" FontSize="11"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                                   Margin="16,7,8,4" />
                                        <ItemsControl ItemsSource="{Binding GameBuild.BootItems}"
                                                      ItemTemplate="{StaticResource IconChip}"
                                                      ItemsPanel="{StaticResource ChipRow}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kern" Style="{StaticResource Small}" FontSize="11"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,7,8,4" MinWidth="70"
                                           ToolTip="In dieser Reihenfolge kaufen — die meistgespielte Kombination dieses Matchups." />
                                <!-- Stats ride along inside the wrap row so they stay next to the
                                     items instead of drifting to the far edge. -->
                                <WrapPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding GameBuild.CoreItems}"
                                                  ItemTemplate="{StaticResource IconChip}"
                                                  ItemsPanel="{StaticResource ChipRow}" />
                                    <TextBlock Text="{Binding GameBuild.CoreStats}" Style="{StaticResource Small}"
                                               FontSize="11" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Top" Margin="10,7,0,4" />
                                </WrapPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spät" Style="{StaticResource Small}" FontSize="11"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                           Margin="0,7,8,4" MinWidth="70"
                                           ToolTip="Häufige Käufe für die letzten Slots — Optionen, keine feste Reihenfolge." />
                                <WrapPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding GameBuild.LateItems}"
                                                  ItemTemplate="{StaticResource IconChip}"
                                                  ItemsPanel="{StaticResource ChipRow}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Spells" Style="{StaticResource Small}" FontSize="11"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                                                   Margin="16,7,8,4" />
                                        <ItemsControl ItemsSource="{Binding GameBuild.Spells}"
                                                      ItemTemplate="{StaticResource IconChip}"
                                                      ItemsPanel="{StaticResource ChipRow}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,8,0,10"
                            Visibility="{Binding GameBuild.HasSkillOrder, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Skill table: which ability gets the point at each level. -->
                    <Grid Visibility="{Binding GameBuild.HasSkillOrder, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SKILLS" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   ToolTip="Welche Fähigkeit auf welcher Stufe einen Punkt bekommt. Stufen 16–18 sind abgeleitet (blasser), nicht gemessen — die Daten reichen bis 15." />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding GameBuild.SkillCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SkillCellViewModel}">
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="{Binding Level}" FontSize="10" TextAlignment="Center"
                                                   Foreground="{StaticResource Faint}"
                                                   FontFamily="{StaticResource NumFont}" />
                                        <Border Width="24" Height="24" CornerRadius="5" Margin="0,2,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUlt}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Ability}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUlt}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDerived}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,10,0,10"
                            Visibility="{Binding HasGameMatchups, Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        The board, lane by lane. Only worth showing once the draft is done — during
                        it the middle column answers the same question for the lane being picked.
                        The rows are frozen from the last render of champion select; see
                        RenderGameMatchups.
                    -->
                    <Grid Visibility="{Binding HasGameMatchups, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LANES" Style="{StaticResource Caption}" VerticalAlignment="Top"
                                   Margin="0,3,14,0"
                                   ToolTip="Die fünf Lanes des fertigen Drafts. Die Prozentzahl ist die Siegquote deiner Seite in diesem Duell." />
                        <!--
                            Shared size scope so the total's figure lands in the same column as the
                            lanes' figures instead of drifting to the panel edge.
                        -->
                        <StackPanel Grid.Column="1" Grid.IsSharedSizeScope="True">
                            <ItemsControl ItemsSource="{Binding GameMatchups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LaneMatchupViewModel}">
                                        <Grid Margin="0,0,0,5" ToolTip="{Binding Note}">
                                            <!--
                                                Fixed name columns, not stars: with stars the two
                                                halves each took what was left and pushed "vs" into
                                                the middle of a very wide row. Fixed widths also keep
                                                the five rows' columns under each other.
                                            -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MatchupVs" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MatchupFigure" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Lane}" Style="{StaticResource Small}"
                                                       Foreground="{StaticResource Faint}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Width="22" Height="22" CornerRadius="5"
                                                    Background="{StaticResource SurfaceAlt}">
                                                <Image Source="{Binding AllyIcon}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Ally}"
                                                       Style="{StaticResource Small}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3" Text="vs" Style="{StaticResource Small}"
                                                       Foreground="{StaticResource Faint}" Margin="4,0,8,0"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="4" Width="22" Height="22" CornerRadius="5"
                                                    Background="{StaticResource SurfaceAlt}">
                                                <Image Source="{Binding EnemyIcon}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding Enemy}"
                                                       Style="{StaticResource Small}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="6" Text="{Binding Figure}"
                                                       FontFamily="{StaticResource NumFont}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding HasFigure, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Strong">
                                                                <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Fair">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The whole draft as one number, under the lanes it is made of. -->
                            <Grid Margin="0,3,0,0"
                                  Visibility="{Binding HasGameMatchupsTotal, Converter={StaticResource BoolToVisibility}}">
                                <!-- Same shape as a lane row, so the two figures share one column. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MatchupVs" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MatchupFigure" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="6" Text="Draft insgesamt"
                                           Style="{StaticResource Small}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           ToolTip="{Binding GameMatchupsTotalHint}" />
                                <TextBlock Grid.Column="6" Text="{Binding GameMatchupsTotal}"
                                           FontFamily="{StaticResource NumFont}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Margin="8,0,0,0" ToolTip="{Binding GameMatchupsTotalHint}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameMatchupsTone}" Value="Ahead">
                                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GameMatchupsTone}" Value="Behind">
                                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Situational hints from the enemy composition, same chips as in the draft. -->
                    <ItemsControl ItemsSource="{Binding BuildHints}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="9"
                                        Padding="8,2" Margin="0,0,5,4"
                                        ToolTip="{Binding Hint}">
                                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource Accent}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--
                ===================== Content: three columns =====================
                Own team left, the suggestions in the middle, the enemies right — the arrangement
                every draft tool converged on, because it matches how the question is asked: my
                side, what to do, their side. The middle column is the widest: it carries the list
                the window exists for.
            -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Left is wider than right: it also carries the build card. Right only
                         needs the champion, the lane dropdown and the confidence. -->
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- Filler keeps all three columns pinned to the top. -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!--
                Enemy column, collapsed as a block when no draft is running. Five empty rows
                outside a champion select are 250 pixels that say nothing.
            -->
            <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                        Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}">

            <!-- ===================== Enemies ===================== -->
            <Grid Margin="2,13,2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GEGNER" Style="{StaticResource Caption}" />
                <Border Grid.Column="1" Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />

                <!-- Their side of the same estimate; the two always add up to 100 %. Never
                     coloured — green on the enemy number would read as good news. -->
                <TextBlock Grid.Column="2" Text="{Binding EnemyWinRateText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontFamily="{StaticResource NumFont}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           ToolTip="{Binding BalanceHint}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Enemies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlotViewModel}">
                        <!--
                            Two lines per seat: the champion reads on the first, the seat label and
                            the lane override sit on the second. One line was what the old wide
                            column allowed; in a 250-px side column it left the champion name about
                            twenty pixels and trimmed nearly every one of them away.
                        -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource IconTile}" Width="32" Height="32">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Champion}"
                                       Style="{StaticResource ChampionName}" Margin="8,0,8,0"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal" Margin="8,4,0,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Faint}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />

                                <!--
                                    Lane override. Shows the lane in effect, predicted or overridden,
                                    and turns accent-coloured once it is set by hand. One-way bound:
                                    the edit is applied in code-behind so a refresh cannot loop back
                                    into it.

                                    Hidden until a champion is revealed. A lane shown for a seat that
                                    has picked nothing would be a guess presented as a reading, and
                                    there is nothing useful to override yet either.
                                -->
                                <ComboBox ItemsSource="{x:Static vm:SlotViewModel.LaneOptions}"
                                          SelectedIndex="{Binding LaneIndex, Mode=OneWay}"
                                          SelectionChanged="LaneOverride_SelectionChanged"
                                          Tag="{Binding}"
                                          VerticalAlignment="Center" Height="24" Width="104"
                                          Visibility="{Binding HasChampion, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="Lane manuell festlegen. „automatisch“ gibt sie an die Vorhersage zurück.">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <!-- The prediction's confidence used to stand next to
                                                     the champion as a percentage, which read like a
                                                     win rate. The figure is gone; what mattered about
                                                     it — "this lane is a guess" — now colours the lane
                                                     itself. Manual wins: a lane you set is not a guess. -->
                                                <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    <Setter Property="ToolTip" Value="Unsichere Lane-Vorhersage — bitte selbst prüfen und notfalls hier umstellen." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManualLane}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            </StackPanel>

            <!--
                Own team column. Same block structure as the enemy column so both sides read the
                same way; the build card sits underneath it because it belongs to your champion.
            -->
            <StackPanel Grid.Row="0" Grid.Column="0"
                        Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}">

            <!-- ===================== Own team ===================== -->
            <Grid Margin="2,13,2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The click hint lives in the tooltip: in the narrow column the visible text
                     squeezed the divider to nothing. -->
                <TextBlock Text="DEIN TEAM" Style="{StaticResource Caption}"
                           ToolTip="Klick auf einen Slot zeigt Empfehlungen für ihn — bis der nächste Zug beginnt." />
                <Border Grid.Column="1" Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />

                <!-- Draft balance for our side. Coloured only beyond a point either way, because
                     inside that band the underlying samples cannot tell the teams apart. -->
                <TextBlock Grid.Column="2" Text="{Binding AllyWinRateText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontFamily="{StaticResource NumFont}"
                           FontSize="14" FontWeight="SemiBold"
                           ToolTip="{Binding BalanceHint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BalanceTone}" Value="Ahead">
                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BalanceTone}" Value="Behind">
                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ItemsControl ItemsSource="{Binding Allies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlotViewModel}">
                        <Button Style="{StaticResource RowButton}" Margin="0,0,0,6"
                                Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Border CornerRadius="8" Padding="4,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- Two lines, mirroring the enemy column: the champion reads on
                                     the first, the seat label and its state on the second. -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Accent bar marks the seat the list is advising. -->
                                    <Border Grid.RowSpan="2" Width="3" CornerRadius="2" Margin="0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource IconTile}" Width="32" Height="32">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Champion}"
                                               Style="{StaticResource ChampionName}" Margin="8,0,8,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3" Text="{Binding LaneText}" Style="{StaticResource Small}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Margin="8,3,0,0">
                                        <!-- Which seat this is. Your own row says so in accent and
                                             bold — the accent BAR on the left means something else
                                             (the seat the list is advising), and the two can differ. -->
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="hovert" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                                                   Visibility="{Binding HasHover, Converter={StaticResource BoolToVisibility}}" />

                                        <Border Background="{StaticResource BadSoft}" CornerRadius="9"
                                                Padding="7,1" VerticalAlignment="Center" Margin="7,0,8,0"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Warning}" FontSize="11"
                                                       Foreground="{StaticResource Bad}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Composition gaps, as chips. -->
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="2,9,2,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WarnSoft}" CornerRadius="10"
                                Padding="10,3" Margin="0,0,6,5">
                            <!-- Wrapping like the build hints: the comp findings are one-liners, but the
                                 queue caveat is a sentence and was cut off at the column edge. -->
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Warn}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!--
                ===================== Your build =====================
                Runes and shopping order for the locked pick, as icon tiles — the same content the
                in-game view shows, sized for the column. Always open: this is what the user came
                for once their pick is locked, and hiding it behind a chevron only cost a click.
            -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource LineSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="13,9" Margin="0,11,0,0"
                    Visibility="{Binding ShowNarrowBuildCard, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- After the draft the teams and the list are gone; the surviving
                                 build card takes the full width instead of one narrow column. -->
                            <DataTrigger Binding="{Binding IsDraftActive}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="5" />
                            </DataTrigger>

                            <!-- The matchup panel shows the same build in the wide column; two
                                 copies of it on one screen would be noise. -->
                            <DataTrigger Binding="{Binding ShowMatchupPanel}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DEIN BUILD" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding BuildTitle}" Style="{StaticResource Small}"
                                   Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BuildSubtitle}" />
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                Command="{Binding CloseBuildCommand}" ToolTip="Build-Karte schließen"
                                Visibility="{Binding ShowBuildClose, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BuildBody}" />
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" LastChildFill="True"
                       Margin="0,13,0,0"
                       Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}">
                <Grid DockPanel.Dock="Top" Margin="2,0,2,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ListHeader}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />

                    <!--
                        Progress of the automatic draft fetch. Not a button: the data for the
                        champions on the board is pulled after every pick by itself, and a button
                        only meant the advice was quietly worse until somebody pressed it.
                    -->
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Text="{Binding DraftFetchText}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowDraftFetchStatus, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Sobald ein Champion aufgedeckt wird, holt DirkDraft dessen aktuelle Counter-Zahlen von OP.GG — und nach deinem eigenen Pick den passenden Build.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraftFetchFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!--
                    The own duel, pinned. The list below follows the clock through the draft, so
                    the full panel came and went with every turn and the own matchup was the thing
                    that kept disappearing. One line, same numbers, never moves.
                -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="10"
                        Padding="12,7" Margin="0,0,10,8"
                        ToolTip="{Binding MatchupNote}"
                        Visibility="{Binding ShowMatchupStrip, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DEIN MATCHUP" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                        <Image Grid.Column="1" Source="{Binding MatchupOwnIcon}" Width="24" Height="24"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="vs" Style="{StaticResource Small}"
                                   Foreground="{StaticResource Faint}" Margin="7,0,7,0"
                                   VerticalAlignment="Center" />
                        <Image Grid.Column="3" Source="{Binding MatchupOpponentIcon}" Width="24" Height="24"
                               VerticalAlignment="Center" />

                        <TextBlock Grid.Column="4" Style="{StaticResource Small}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding MatchupHeadline, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource Faint}" />
                            <Run Text="{Binding MatchupSubline, Mode=OneWay}"
                                 Foreground="{StaticResource Muted}" />
                        </TextBlock>

                        <TextBlock Grid.Column="5" Text="{Binding MatchupFigure}"
                                   FontFamily="{StaticResource NumFont}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding HasMatchupFigure, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MatchupTone}" Value="Strong">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MatchupTone}" Value="Fair">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid>
                    <!-- Empty state instead of a blank gap. -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="18" VerticalAlignment="Top"
                            Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Small}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Faint}" />
                    </Border>

                    <!--
                        Once the own pick is locked and nobody on our team is on the clock, a list
                        of alternatives is advice about a settled decision. The column that carries
                        the window then shows the duel that WILL be played, and the build gets the
                        width it needs — the same markup as the narrow card, wrapped wider.
                    -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ShowMatchupPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,0,10,0">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding MatchupOwnIcon}" Width="42" Height="42"
                                               VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="vs" Style="{StaticResource Small}"
                                                   Foreground="{StaticResource Faint}" Margin="9,0,9,0"
                                                   VerticalAlignment="Center" />
                                        <Image Grid.Column="2" Source="{Binding MatchupOpponentIcon}"
                                               Width="42" Height="42" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MatchupHeadline}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MatchupSubline}" Style="{StaticResource Small}"
                                                       Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="4" CornerRadius="9" Padding="10,4"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasMatchupFigure, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Siegquote dieses Duells nach OP.GG-Daten. 50 % wäre ausgeglichen.">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchupTone}" Value="Strong">
                                                            <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MatchupTone}" Value="Fair">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MatchupFigure}" FontFamily="{StaticResource NumFont}"
                                                       FontSize="15" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchupTone}" Value="Strong">
                                                                <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchupTone}" Value="Fair">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding MatchupNote}" Style="{StaticResource Small}"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <!--
                                Only when there is a build, or a matchup one is being fetched for.
                                Without the condition this card appeared under every matchup panel -
                                including one for a team-mate while we had not picked at all, where
                                it showed an empty body under a heading left over from the last draft.
                            -->
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,11,0,0"
                                    Visibility="{Binding ShowBuildSection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DEIN BUILD" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding BuildTitle}"
                                                   Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding BuildSubtitle}" />
                                    </Grid>

                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BuildBody}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibility}}">
                        <!-- Right margin keeps the scrollbar clear of the cards instead of over them. -->
                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecommendationViewModel}">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Rank}" Style="{StaticResource Small}"
                                                           Foreground="{StaticResource Faint}"
                                                           FontFamily="{StaticResource NumFont}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7"
                                                        Background="{StaticResource SurfaceAlt}"
                                                        HorizontalAlignment="Left" ClipToBounds="True">
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="15"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Margin="2,0,8,0" />

                                                <!-- Score pill, tinted by how strong the pick is. -->
                                                <Border Grid.Column="3" CornerRadius="7" Padding="9,3"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding ScoreHint}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Strong">
                                                                    <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Fair">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Score}" FontFamily="{StaticResource NumFont}"
                                                               FontSize="13" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Strong">
                                                                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Fair">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <ToggleButton Grid.Column="4" Style="{StaticResource Chevron}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              ToolTip="Zeigt, was für und gegen diesen Pick spricht" />
                                            </Grid>

                                            <!-- Reason chips, coloured by whether they argue for or against. -->
                                            <ItemsControl ItemsSource="{Binding Reasons}" Margin="62,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Hover explains where the number comes from; null Hint simply shows none. -->
                                                        <Border CornerRadius="9" Padding="8,2" Margin="0,0,5,4"
                                                                ToolTip="{Binding Hint}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="Pro">
                                                                            <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="Contra">
                                                                            <Setter Property="Background" Value="{StaticResource BadSoft}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                                       TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="Pro">
                                                                                <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tone}" Value="Contra">
                                                                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!--
                                                Breakdown. Every line names the criterion, says in
                                                words what it found, and shows how far it moved the
                                                score - the bare arithmetic that used to stand here
                                                was unreadable. The raw numbers live in the tooltip.
                                            -->
                                            <Border Margin="62,5,0,0" Padding="10,8" CornerRadius="7"
                                                    Background="{StaticResource Bg}"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="WAS DAFÜR UND DAGEGEN SPRICHT"
                                                               Style="{StaticResource Caption}"
                                                               Margin="0,0,0,6" />

                                                    <ItemsControl ItemsSource="{Binding Breakdown}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TermViewModel}">
                                                                <Grid Margin="0,2" Background="Transparent"
                                                                      ToolTip="{Binding Hint}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="98" />
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!-- Zero-centred bar: green to the right, red to the left. -->
                                                                    <Grid Grid.Column="1" Height="7" Margin="0,0,9,0"
                                                                          VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="1" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Rectangle Grid.Column="1" Fill="{StaticResource Line}" />
                                                                        <Rectangle HorizontalAlignment="Right" RadiusX="2" RadiusY="2"
                                                                                   Width="{Binding BarNegative}"
                                                                                   Fill="{StaticResource Bad}" />
                                                                        <Rectangle Grid.Column="2" HorizontalAlignment="Left"
                                                                                   RadiusX="2" RadiusY="2"
                                                                                   Width="{Binding BarPositive}"
                                                                                   Fill="{StaticResource Good}" />
                                                                    </Grid>

                                                                    <TextBlock Grid.Column="2" Text="{Binding Verdict}"
                                                                               FontSize="11" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Pro">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Contra">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <TextBlock Grid.Column="3" Text="{Binding Value}"
                                                                               Style="{StaticResource Mono}" FontSize="11"
                                                                               MinWidth="38" TextAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource Faint}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="1" Background="{StaticResource Line}"
                                                            Margin="0,7,0,6" />

                                                    <Grid ToolTip="Alle Kriterien zusammengerechnet: die geschätzte Siegquote dieser Aufstellung. 50 % wäre ausgeglichen.">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TotalLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <!-- Right-aligned next to the number: the verdict needs the
                                                             room more than it needs to line up with the rows above. -->
                                                        <TextBlock Grid.Column="1" Text="{Binding ScoreVerdict}"
                                                                   Style="{StaticResource Small}" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="10,0,9,0"
                                                                   TextAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Score}"
                                                                   Style="{StaticResource Mono}" FontSize="11"
                                                                   FontWeight="SemiBold" MinWidth="38"
                                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Text}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
            </Grid>

            <!-- ===================== Footer ===================== -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SnapshotText}" FontSize="11"
                                   ToolTip="{Binding SnapshotDetail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMeta}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Small}"
                                   Foreground="{StaticResource Accent}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding UpdateDataCommand}" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                <Setter Property="Content" Value="Daten aktualisieren" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                        <Setter Property="Content" Value="Aktualisiere…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ToolTip>
                            <TextBlock Text="Holt Tierlist, Counter, Synergien und Icons von OP.GG. Während eines Champ Select gesperrt." />
                        </Button.ToolTip>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Abbrechen"
                            Command="{Binding CancelUpdateCommand}" Margin="6,0,0,0"
                            Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Progress of the running update. Four minutes without visible movement reads as a hang. -->
                <Border Height="3" CornerRadius="2" Margin="0,7,0,0"
                        Background="{StaticResource SurfaceHi}" ClipToBounds="True"
                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource Accent}" CornerRadius="2"
                            HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding UpdateFraction}" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>

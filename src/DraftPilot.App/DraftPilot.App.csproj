<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The product's outward name; internal namespaces keep the original working title. -->
    <AssemblyName>DirkDraft</AssemblyName>
    <RootNamespace>DraftPilot.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Keep the idle footprint small: workstation GC, no background collection thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- The version the update check compares against GitHub Releases. release.ps1 bumps it. -->
    <Version>1.0.2</Version>

    <!-- Velopack must run before WPF: Program.Main hosts it, the generated Main is bypassed. -->
    <StartupObject>DraftPilot.App.Program</StartupObject>

    <!-- Velopack updates loose files and cannot patch a single-file bundle. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms stays out of the implicit using set: only TrayPresence needs it, and its
         Application, ComboBox and Label types otherwise collide with the WPF ones. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraftPilot.Core\DraftPilot.Core.csproj" />
    <ProjectReference Include="..\DraftPilot.Meta\DraftPilot.Meta.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Curated, read-only data files ship next to the executable. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>

# Einstellungen des Sammlers. Kopieren nach /etc/dirkdraft-collector.env, dann:
#   sudo chown root:dirkdraft /etc/dirkdraft-collector.env && sudo chmod 640 /etc/dirkdraft-collector.env
# Die Datei enthält den Riot-Schlüssel: nie ins Repository, nie in ein Log.
# Format: NAME=Wert, ohne Anführungszeichen und ohne Leerzeichen um das Gleichheitszeichen
# (systemd liest die Datei ebenso wie das Skript).

# Der Riot-Schlüssel (derselbe wie das Repository-Secret RIOT_API_KEY).
RIOT_API_KEY=

# Passwort für das tägliche Backup des Stands (derselbe Wert wie das Secret STATE_BACKUP_KEY, damit
# sich auch ein Backup aus GitHub Actions hier einspielen lässt). Ohne ihn gibt es kein Backup.
STATE_BACKUP_KEY=

# Der Checkout, aus dem gebaut wird.
REPO_DIR=/opt/dirkdraft

# Hier liegt der Stand (riot-state.json.gz, aram-state.json.gz). systemd legt den Ordner an.
STATE_DIR=/var/lib/dirkdraft-collector

# Wohin das tägliche Backup geht. Am besten ein anderer Datenträger als STATE_DIR (USB-Stick, NAS):
# Ein Backup auf derselben SD-Karte übersteht deren Ausfall nicht.
BACKUP_DIR=/var/lib/dirkdraft-collector/backups
BACKUP_KEEP_DAYS=14

# Der private Deploy-Key mit Schreibrecht auf das Repository (LIESMICH.md, Schritt 4).
DEPLOY_KEY=/var/lib/dirkdraft-collector/.ssh/dirkdraft-data
DATA_REMOTE=git@github.com:Sazzlez/DirkDraft.git
DATA_BRANCH=data

# Wie im Workflow: 270 Minuten Ranked, 60 Minuten ARAM je Lauf.
MINUTES=270
ARAM_MINUTES=60
TIERS=platinum

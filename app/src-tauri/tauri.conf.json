{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DirkDraft",
  "identifier": "com.sazzlez.dirkdraft",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://raw.githubusercontent.com https://ddragon.leagueoflegends.com",
        "img-src": "'self' data: https://ddragon.leagueoflegends.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
